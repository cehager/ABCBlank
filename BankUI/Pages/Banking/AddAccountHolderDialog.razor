<MudForm @ref="@_form" Model="CreateAccountHolderRequest" Validation="@(_validator.ValidateValue)" ValidationDelay="0">
    <MudDialog>
    <TitleContent>
        Add Account Holder
     </TitleContent>
    <DialogContent>
            <MudTextField @bind-Value="CreateAccountHolderRequest.FirstName" Label="First Name"
            For="@(() => CreateAccountHolderRequest.FirstName)" Variant="Variant.Outlined"></MudTextField>
            
            <MudTextField @bind-Value="CreateAccountHolderRequest.LastName" Label="Last Name"
            For="@(() => CreateAccountHolderRequest.LastName)" Variant="Variant.Outlined"></MudTextField>

            <MudDatePicker Label="Birthday" Editable="true" @bind-Date="CreateAccountHolderRequest.DateOfBirth"
                           For="@(() => CreateAccountHolderRequest.DateOfBirth)" Placeholder=" Select Date" />
            
            <MudTextField @bind-Value="CreateAccountHolderRequest.ContactNumber" Label="Phone"
                          For="@(() => CreateAccountHolderRequest.ContactNumber)" Variant="Variant.Outlined"></MudTextField>
            
            <MudTextField @bind-Value="CreateAccountHolderRequest.Email" Label="Email"
                          For="@(() => CreateAccountHolderRequest.Email)" Variant="Variant.Outlined"></MudTextField>

     </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Color="Color.Success" OnClick="SubmitAsync"
            Variant="Variant.Filled"
            Disabled="@(!_validator.Validate(CreateAccountHolderRequest).IsValid)">Save</MudButton>
    </DialogActions>
</MudDialog>
</MudForm>