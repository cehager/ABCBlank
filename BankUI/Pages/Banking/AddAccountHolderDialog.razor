<MudForm @ref="@_form" Model="CreateAccountHolderRequest">
    <MudDialog>
    <TitleContent>
        Add Account Holder
     </TitleContent>
    <DialogContent>
            <MudTextField @bind-Value="CreateAccountHolderRequest.FirstName" Label="First Name" Variant="Variant.Outlined"></MudTextField>
            <MudTextField @bind-Value="CreateAccountHolderRequest.LastName" Label="Last Name" Variant="Variant.Outlined"></MudTextField>
            <MudDatePicker Label="Birthday" Editable="true" @bind-Date="CreateAccountHolderRequest.DateOfBirth" Placeholder=" Select Date" />
            <MudTextField @bind-Value="CreateAccountHolderRequest.ContactNumber" Label="Phone" Variant="Variant.Outlined"></MudTextField>
            <MudTextField @bind-Value="CreateAccountHolderRequest.Email" Label="Email" Variant="Variant.Outlined"></MudTextField>
     </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="SaveAsync">Add</MudButton>
    </DialogActions>
</MudDialog>
</MudForm>